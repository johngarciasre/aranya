# Copy to .local/production.env and replace the example values for your environment.
# This is a trusted Bash environment file; source it only after editing it.
# Leave private IPs to preflight; it writes NODE1_PRIVATE_IP through NODE3_PRIVATE_IP.
NODE1_PUBLIC_IP=198.51.100.11
NODE2_PUBLIC_IP=198.51.100.12
NODE3_PUBLIC_IP=198.51.100.13
ANSIBLE_USER=ubuntu
SSH_KEY="$HOME/.ssh/assignment_key"
FIREWALL_ADMIN_SOURCES=203.0.113.10
FIREWALL_PRIVATE_INTERFACE=eth1
FIREWALL_PUBLIC_INTERFACE=eth0
KUBE_PODS_SUBNET=10.233.64.0/18
KUBE_SERVICE_ADDRESSES=10.233.0.0/18
